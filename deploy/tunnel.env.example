# The tunnel and README link updater. Copy to /etc/grove/tunnel.env (owner grove, mode 600).
# Never commit the real file. No Firebase settings belong here (they go in web.env).
GROVE_PORT=8787
GROVE_DATA_DIR=/var/lib/grove
GITHUB_REPO=your-name/your-private-repo
GITHUB_TOKEN=your-fine-grained-token

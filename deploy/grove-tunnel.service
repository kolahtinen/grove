[Unit]
Description=grove quick tunnel and README link updater
After=network-online.target grove.service
Wants=network-online.target

[Service]
Type=simple
User=grove
Group=grove
WorkingDirectory=/opt/grove
EnvironmentFile=/etc/grove/tunnel.env
ExecStart=/usr/bin/node tunnel/supervisor.mjs
Restart=always
RestartSec=5
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
# systemd reads EnvironmentFile as root first; the process itself can't open the other's secrets (FR-004).
InaccessiblePaths=/etc/grove/web.env /etc/grove/service-account.json
ReadWritePaths=/var/lib/grove

[Install]
WantedBy=multi-user.target

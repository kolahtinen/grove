[Unit]
Description=grove web server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=grove
Group=grove
WorkingDirectory=/opt/grove
EnvironmentFile=/etc/grove/web.env
ExecStart=/usr/bin/node server/main.mjs
Restart=always
RestartSec=3
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
# systemd reads EnvironmentFile as root first; the process itself can't open the other's secrets (FR-004).
InaccessiblePaths=/etc/grove/tunnel.env
ReadWritePaths=/var/lib/grove /mnt/grove-backup

[Install]
WantedBy=multi-user.target

# grove's server and the owner commands. Copy to /etc/grove/web.env (owner grove, mode 600).
# Never commit the real file. The GitHub token does not belong here (it goes in tunnel.env).
GROVE_PORT=8787
GROVE_DATA_DIR=/var/lib/grove
GROVE_BACKUP_DIR=/mnt/grove-backup
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_API_KEY=your-web-api-key
FIREBASE_SERVICE_ACCOUNT_FILE=/etc/grove/service-account.json
# Prompt sizes (G-02 FR-202), set from the probe test; leave out to use the defaults shown.
# GROVE_PART_READING=2
# GROVE_PART_LISTENING=1
# GROVE_TEXT_WORDS=90
# GROVE_SETUP_CHUNK_WORDS=500
# GROVE_SETUP_MAX_WORDS=3000
# GROVE_CHECK_MEANINGS=20
# GROVE_OWN_PIECE_CHARS=2500

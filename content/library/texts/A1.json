    {
      "id": "A1-03",
      "topic": "Food and drink",
      "form": "dialogue",
      "kind": "reading",
      "title": "På kaféet",
      "names": [
        "Lisa"
      ],
      "above_level": [
        "kopp",
        "kaffe",
        "mjölk",
        "smörgås",
        "skinka"
      ],
      "lines": [
        {
          "sv": "– Hej! Vad vill du ha?",
          "en": "– Hi! What would you like?"
        },
        {
          "sv": "– Hej! En kopp kaffe, tack.",
          "en": "– Hi! A cup of coffee, please."
        },
        {
          "sv": "– Vill du ha mjölk i kaffet?",
          "en": "– Would you like milk in the coffee?"
        },
        {
          "sv": "– Ja, lite mjölk, tack.",
          "en": "– Yes, a little milk, please."
        },
        {
          "sv": "– Vill du ha något att äta?",
          "en": "– Would you like something to eat?"
        },
        {
          "sv": "– Ja. Har ni smörgåsar?",
          "en": "– Yes. Do you have sandwiches?"
        },
        {
          "sv": "– Ja, med ost eller med skinka.",
          "en": "– Yes, with cheese or with ham."
        },
        {
          "sv": "– Jag tar en med ost.",
          "en": "– I'll have one with cheese."
        },
        {
          "sv": "– Något mer?",
          "en": "– Anything else?"
        },
        {
          "sv": "– Nej tack. Vad kostar det?",
          "en": "– No thanks. How much is it?"
        },
        {
          "sv": "– Det kostar sjuttio kronor.",
          "en": "– It costs seventy kronor."
        },
        {
          "sv": "– Kan jag betala med kort?",
          "en": "– Can I pay by card?"
        },
        {
          "sv": "– Ja, det går bra.",
          "en": "– Yes, that's fine."
        },
        {
          "sv": "– Tack så mycket! Hej då!",
          "en": "– Thank you very much! Bye!"
        }
      ],
      "questions": [

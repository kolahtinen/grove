          "sv": "Lägenheten har två rum och kök.",
          "en": "The flat has two rooms and a kitchen."
        },
        {
          "sv": "Den ligger på tredje våningen.",
          "en": "It is on the third floor."
        },
        {
          "sv": "I vardagsrummet finns en soffa och ett bord.",
          "en": "In the living room there is a sofa and a table."
        },
        {
          "sv": "Där står också en stor lampa.",
          "en": "There is also a big lamp there."
        },
        {
          "sv": "I sovrummet har hon en säng.",
          "en": "In the bedroom she has a bed."
        },
        {
          "sv": "Köket är litet men ljust.",
          "en": "The kitchen is small but light."
        },
        {
          "sv": "Från fönstret ser hon en park.",
          "en": "From the window she sees a park."
        },
        {
          "sv": "Lisa tycker om sin lägenhet.",
          "en": "Lisa likes her flat."
        },
        {
          "sv": "Hyran är inte så hög.",
          "en": "The rent is not so high."
        }
      ],
      "questions": [

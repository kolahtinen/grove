        {
          "sv": "– Den finns där borta, till höger.",
          "en": "– It's over there, on the right."
        },
        {
          "sv": "– Tack. Och var finns bröd?",
          "en": "– Thanks. And where is the bread?"
        },
        {
          "sv": "– Brödet ligger vid kassan.",
          "en": "– The bread is by the till."
        },
        {
          "sv": "– Har ni äpplen?",
          "en": "– Do you have apples?"
        },
        {
          "sv": "– Ja, de är här.",
          "en": "– Yes, they are here."
        },
        {
          "sv": "– Vad kostar de?",
          "en": "– How much are they?"
        },
        {
          "sv": "– Tjugo kronor kilot.",
          "en": "– Twenty kronor a kilo."
        },
        {
          "sv": "– Då tar jag ett kilo.",
          "en": "– Then I'll take a kilo."
        },
        {
          "sv": "– Vill du ha en påse?",
          "en": "– Would you like a bag?"
        },
        {
          "sv": "– Nej tack, jag har en egen.",
          "en": "– No thanks, I have my own."
        },
        {
          "sv": "– Bra. Ha en trevlig dag!",
          "en": "– Good. Have a nice day!"
        },
        {
          "sv": "– Tack, detsamma!",
          "en": "– Thanks, you too!"
        }

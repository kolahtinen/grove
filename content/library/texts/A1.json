    {
      "id": "A1-10",
      "topic": "Health",
      "form": "dialogue",
      "kind": "reading",
      "title": "Jag är sjuk",
      "names": [
        "Karin",
        "Peter"
      ],
      "above_level": [
        "åh",
        "hals",
        "feber",
        "vila",
        "krya"
      ],
      "lines": [
        {
          "sv": "– Hej Karin, det är Peter.",
          "en": "– Hi Karin, it's Peter."
        },
        {
          "sv": "– Hej Peter! Hur mår du?",
          "en": "– Hi Peter! How are you?"
        },
        {
          "sv": "– Inte bra. Jag är sjuk.",
          "en": "– Not good. I'm ill."
        },
        {
          "sv": "– Åh nej! Vad är det?",
          "en": "– Oh no! What is it?"
        },
        {
          "sv": "– Jag har ont i halsen och huvudet.",
          "en": "– I have a sore throat and a headache."
        },
        {
          "sv": "– Har du feber?",
          "en": "– Do you have a temperature?"
        },
        {
          "sv": "– Ja, lite.",
          "en": "– Yes, a little."
        },
        {
          "sv": "– Du måste stanna hemma i dag.",
          "en": "– You have to stay at home today."
        },
        {
          "sv": "– Ja, jag kan inte komma till jobbet.",
          "en": "– Yes, I can't come to work."

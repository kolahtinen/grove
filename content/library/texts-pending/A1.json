    {
      "id": "A1-32",
      "level": "A1",
      "topic": "People and family",
      "form": "prose",
      "kind": "reading",
      "title": "Min stora familj",
      "names": [
        "Omar",
        "Uppsala",
        "Lina",
        "Sami",
        "Noor",
        "Adam",
        "Göteborg"
      ],
      "above_level": [
        "restaurang",
        "sjunga",
        "middag"
      ],
      "lines": [
        {
          "sv": "Jag heter Omar och jag är trettio år.",
          "en": "My name is Omar and I am thirty."
        },
        {
          "sv": "Jag bor i Uppsala med min fru och våra barn.",
          "en": "I live in Uppsala with my wife and our children."
        },
        {
          "sv": "Min fru heter Lina.",
          "en": "My wife's name is Lina."
        },
        {
          "sv": "Hon är lärare.",
          "en": "She is a teacher."
        },
        {
          "sv": "Jag jobbar på en restaurang.",
          "en": "I work at a restaurant."
        },
        {
          "sv": "Vi har tre barn.",
          "en": "We have three children."
        },
        {
          "sv": "Sami är åtta år och går i skolan.",
          "en": "Sami is eight and goes to school."
        },
        {
          "sv": "Noor är fem år.",
          "en": "Noor is five."
        },
        {
          "sv": "Hon leker mycket och sjunger hela dagen.",
          "en": "She plays a lot and sings all day."
        },
        {
          "sv": "Lilla Adam är ett år.",
          "en": "Little Adam is one."
        },
        {
          "sv": "Han sover mycket och äter mycket.",
          "en": "He sleeps a lot and eats a lot."
        },
        {
          "sv": "Min mamma och pappa bor nära oss.",
          "en": "My mum and dad live near us."
        },
        {
          "sv": "De kommer hem till oss varje söndag.",
          "en": "They come to our home every Sunday."
        },
        {
          "sv": "Då äter vi middag tillsammans.",
          "en": "Then we have dinner together."
        },
        {
          "sv": "Min pappa lagar mat.",
          "en": "My dad cooks."
        },
        {
          "sv": "Han gör ris och kyckling.",
          "en": "He makes rice and chicken."
        },
        {
          "sv": "Min mamma läser för barnen.",
          "en": "My mum reads to the children."
        },
        {
          "sv": "Min bror bor i Göteborg.",
          "en": "My brother lives in Gothenburg."
        },
        {
          "sv": "Han ringer ofta på kvällen.",
          "en": "He often calls in the evening."
        },
        {
          "sv": "Ibland är huset fullt och högt.",
          "en": "Sometimes the house is full and loud."
        },
        {
          "sv": "Men jag tycker om det.",
          "en": "But I like it."
        },
        {
          "sv": "Familjen är viktig för mig.",
          "en": "Family is important to me."
        }
      ],
      "questions": [
        {
          "q": "Hur många barn har Omar?",
          "options": [

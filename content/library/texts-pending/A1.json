        {
          "sv": "I dag städar vi parken.",
          "en": "Today we are cleaning the park."
        },
        {
          "sv": "Vi är tio grannar.",
          "en": "There are ten of us neighbours."
        },
        {
          "sv": "Alla har en påse.",
          "en": "Everyone has a bag."
        },
        {
          "sv": "Barnen hittar mycket skräp.",
          "en": "The children find a lot of litter."
        },
        {
          "sv": "Sedan dricker vi kaffe tillsammans.",
          "en": "Then we drink coffee together."
        },
        {
          "sv": "Nu är parken fin.",
          "en": "Now the park is nice."
        }
      ],

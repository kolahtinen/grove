{
  "name": "grove",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.14"
  },
  "scripts": {
    "test": "node --test --test-concurrency=1 \"tests/**/*.test.mjs\"",
    "test:e2e": "playwright test",
    "check": "npm audit --audit-level=high && gitleaks detect --no-banner && semgrep --config p/javascript --error --quiet --metrics off server tunnel public/assets scripts && node scripts/check-trace.mjs",
    "dev": "node tests/fakes/dev-server.mjs --port 8787",
    "start": "node server/main.mjs",
    "tunnel": "node tunnel/supervisor.mjs",
    "postinstall": "node scripts/copy-fonts.mjs",
    "owner:setup": "node server/owner/cli.mjs owner:setup",
    "reviewer:setup": "node server/owner/cli.mjs reviewer:setup",
    "learner:export": "node server/owner/cli.mjs learner:export",
    "learner:delete": "node server/owner/cli.mjs learner:delete",
    "log:show": "node server/owner/cli.mjs log:show",
    "availability:show": "node server/owner/cli.mjs availability:show",
    "reports:show": "node server/owner/cli.mjs reports:show",
    "backup:now": "node server/owner/cli.mjs backup:now",
    "backup:restore": "node server/owner/cli.mjs backup:restore"
  },
  "dependencies": {
    "@fontsource/zen-kaku-gothic-new": "5.3.1"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1"
  }
}
